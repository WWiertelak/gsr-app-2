#: gsr/errors.py:63
msgid ""
"This is not an eSense CSV export: no header row with a MICROSIEMENS column "
"was found in the first 80 lines."
msgstr ""
"To nie jest eksport CSV z eSense: w pierwszych 80 wierszach nie ma nagłówka "
"z kolumną MICROSIEMENS."

#: gsr/errors.py:67
msgid ""
"The file's text encoding is not supported. Save it as a UTF-8 CSV and upload "
"it again."
msgstr ""
"Kodowanie tekstu pliku nie jest obsługiwane. Zapisz go jako CSV w UTF-8 i "
"wgraj ponownie."

#: gsr/errors.py:69
msgid "The file has no time column (ZNACZNIKI CZASU or TIMESTAMP)."
msgstr "W pliku brakuje kolumny czasu (ZNACZNIKI CZASU lub TIMESTAMP)."

#: gsr/errors.py:71
msgid "The file has no MICROSIEMENS column."
msgstr "W pliku brakuje kolumny MICROSIEMENS."

#: gsr/errors.py:73
#, python-format
msgid ""
"The time goes backwards at data row %(row)s; only a midnight rollover may do "
"that."
msgstr ""
"Czas cofa się w wierszu danych %(row)s; dozwolone jest to tylko przy "
"przejściu przez północ."

#: gsr/errors.py:75
msgid "The file contains no readable signal rows."
msgstr "Plik nie zawiera żadnych czytelnych wierszy sygnału."

#: gsr/errors.py:76
msgid "The file could not be read as an eSense CSV export."
msgstr "Nie udało się odczytać pliku jako eksportu CSV z eSense."

#: gsr/errors.py:80 gsr/templates/gsr/partials/cleaning_main.html:58
msgid "Go to Import"
msgstr "Przejdź do importu"

#: gsr/errors.py:84 gsr/templates/gsr/partials/analysis_main.html:44
msgid "Go to Cleaning"
msgstr "Przejdź do czyszczenia"

#: gsr/errors.py:98
msgid ""
"The recordings do not share a common time window, so they cannot be analysed "
"together."
msgstr ""
"Nagrania nie mają wspólnego okna czasu, więc nie można ich analizować razem."

#: gsr/errors.py:101
#, python-format
msgid ""
"%(aliases)s does not overlap with the other recordings (their common window "
"is %(start)s–%(end)s)."
msgid_plural ""
"%(aliases)s do not overlap with the other recordings (their common window is "
"%(start)s–%(end)s)."
msgstr[0] ""
"%(aliases)s nie nakłada się z pozostałymi nagraniami (ich wspólne okno to "
"%(start)s–%(end)s)."
msgstr[1] ""
"%(aliases)s nie nakładają się z pozostałymi nagraniami (ich wspólne okno to "
"%(start)s–%(end)s)."
msgstr[2] ""
"%(aliases)s nie nakładają się z pozostałymi nagraniami (ich wspólne okno to "
"%(start)s–%(end)s)."

#: gsr/errors.py:120
#, python-format
msgid "Signal %(alias)s cannot be read. %(reason)s"
msgstr "Nie można odczytać sygnału %(alias)s. %(reason)s"

#: gsr/errors.py:126
#, python-format
msgid "The file of signal %(alias)s is missing. Upload it again."
msgstr "Brakuje pliku sygnału %(alias)s. Wgraj go ponownie."

#: gsr/errors.py:129
#, python-format
msgid "Signal %(alias)s has no samples in the common time window."
msgstr "Sygnał %(alias)s nie ma próbek we wspólnym oknie czasu."

#: gsr/errors.py:133
#, python-format
msgid ""
"Signal %(alias)s has no samples in the selected time range. Widen the time "
"range in the cleaning settings."
msgstr ""
"Sygnał %(alias)s nie ma próbek w wybranym zakresie czasu. Poszerz zakres "
"czasu w ustawieniach czyszczenia."

#: gsr/errors.py:137
msgid "The recordings have no time points in common after synchronization."
msgstr "Po synchronizacji nagrania nie mają wspólnych punktów czasu."

#: gsr/errors.py:139
msgid ""
"Too few samples remain for analysis. Widen the time range in the cleaning "
"settings."
msgstr ""
"Do analizy zostało za mało próbek. Poszerz zakres czasu w ustawieniach "
"czyszczenia."

#: gsr/errors.py:142
msgid "Group analysis needs at least two signals."
msgstr "Analiza grupowa wymaga co najmniej dwóch sygnałów."

#: gsr/errors.py:144
msgid "No signals are selected."
msgstr "Nie wybrano żadnych sygnałów."

#: gsr/errors.py:145
msgid "Include more signals on the Cleaning step or upload more recordings."
msgstr "Zaznacz więcej sygnałów w kroku Czyszczenie albo wgraj więcej nagrań."

#: gsr/params.py:53
msgid ""
"Time range (in minutes) defines which part of the recording is analyzed. "
"After import, signals are synchronized to a common window. Narrow the range, "
"e.g. to skip warm-up or end-of-session noise."
msgstr ""
"Zakres czasu (w minutach) wyznacza fragment nagrania do analizy. Po imporcie "
"sygnały są synchronizowane do wspólnego okna. Zawęź zakres, np. aby pominąć "
"fazę rozgrzewki lub zakłócenia na końcu nagrania."

#: gsr/params.py:57
msgid "From (min)"
msgstr "Od (min)"

#: gsr/params.py:58
msgid "To (min)"
msgstr "Do (min)"

#: gsr/params.py:65 gsr/params.py:73
msgid "Physiological range"
msgstr "Zakres fizjologiczny"

#: gsr/params.py:66
msgid "Rejects values outside the configured physiological GSR range."
msgstr "Odrzuca wartości poza zadanym zakresem fizjologicznym GSR."

#: gsr/params.py:68
msgid "Min (µS)"
msgstr "Min (µS)"

#: gsr/params.py:69
msgid "Max (µS)"
msgstr "Max (µS)"

#: gsr/params.py:74
msgid ""
"Protects against non-physiological values caused by measurement glitches or "
"sensor issues."
msgstr ""
"Chroni przed wartościami niefizjologicznymi wynikającymi np. z błędu pomiaru "
"lub awarii sensora."

#: gsr/params.py:80 gsr/params.py:85
msgid "Z-score deviation"
msgstr "Odchylenie Z-score"

#: gsr/params.py:81
msgid "Rejects points that are statistical outliers against the full signal."
msgstr "Odrzuca punkty statystycznie odstające względem całego sygnału."

#: gsr/params.py:82
msgid "Threshold (SD)"
msgstr "Próg (SD)"

#: gsr/params.py:86
msgid ""
"The farther from the mean (in SD units), the more likely a point is an "
"artifact."
msgstr ""
"Im większa odchyłka od średniej (w SD), tym większa szansa, że punkt jest "
"artefaktem."

#: gsr/params.py:92 gsr/params.py:97
msgid "Abrupt jumps"
msgstr "Nagłe skoki"

#: gsr/params.py:93
msgid ""
"Rejects samples with unnaturally large changes between consecutive points."
msgstr "Odrzuca próbki z nienaturalnie dużą zmianą między kolejnymi punktami."

#: gsr/params.py:94
msgid "Sigma"
msgstr "Sigma"

#: gsr/params.py:98
msgid ""
"Helps remove sudden spikes typically caused by electrode movement or "
"transient interference."
msgstr ""
"Pomaga usuwać ostre skoki amplitudy, typowe dla ruchu elektrody lub zakłóceń "
"chwilowych."

#: gsr/params.py:104 gsr/params.py:109
msgid "Interquartile range (IQR)"
msgstr "Zakres kwartylowy (IQR)"

#: gsr/params.py:105
msgid "Rejects points outside [Q1-k*IQR, Q3+k*IQR]."
msgstr "Odrzuca punkty poza zakresem kwartylowym [Q1-k*IQR, Q3+k*IQR]."

#: gsr/params.py:106
msgid "IQR factor"
msgstr "Współczynnik IQR"

#: gsr/params.py:110
msgid ""
"IQR filtering is robust for non-normal distributions and catches heavy-tail "
"points well."
msgstr ""
"Filtrowanie IQR jest odporne na rozkłady nienormalne i dobrze wyłapuje ogony "
"rozkładu."

#: gsr/params.py:116 gsr/params.py:124
msgid "Butterworth filter"
msgstr "Filtr Butterwortha"

#: gsr/params.py:117
msgid "Smooths the signal with a low-pass filter after interpolation."
msgstr "Wygładza sygnał filtrem dolnoprzepustowym po interpolacji braków."

#: gsr/params.py:119
msgid "Cutoff (Hz)"
msgstr "Odcięcie (Hz)"

#: gsr/params.py:120
msgid "Order"
msgstr "Rząd"

#: gsr/params.py:125
msgid "Removes high-frequency noise and keeps slower GSR signal dynamics."
msgstr ""
"Usuwa wysokoczęstotliwościowy szum i zostawia wolniejsze zmiany sygnału GSR."

#: gsr/params.py:133
msgid "Median filter"
msgstr "Filtr medianowy"

#: gsr/params.py:135
msgid ""
"Filter window size (in samples). 0 disables the filter. Small values (e.g. 3–"
"11) preserve details but reduce noise less. Large values (e.g. 51–201) "
"smooth more aggressively. Only odd values are used — even values are rounded "
"up automatically."
msgstr ""
"Rozmiar okna filtra (w próbkach). Wartość 0 wyłącza filtr. Mała wartość (np. "
"3–11) zachowuje detale, ale słabiej redukuje szum. Duża wartość (np. 51–201) "
"mocno wygładza sygnał. Używane są wyłącznie wartości nieparzyste — parzyste "
"są automatycznie zaokrąglane w górę."

#: gsr/params.py:139
msgid "Window size (samples)"
msgstr "Rozmiar okna (próbki)"

#: gsr/params.py:147
msgid "Synchronization threshold"
msgstr "Próg synchronizacji"

#: gsr/params.py:148
msgid ""
"Pairs whose windowed correlation reaches this value count as synchronized in "
"that window."
msgstr ""
"Pary, których korelacja w oknie osiąga tę wartość, są w tym oknie uznawane "
"za zsynchronizowane."

#: gsr/params.py:150 gsr/params.py:206
msgid "Window (s)"
msgstr "Okno (s)"

#: gsr/params.py:153 gsr/params.py:212
msgid "Step (s)"
msgstr "Krok (s)"

#: gsr/params.py:156
msgid "Correlation method"
msgstr "Metoda korelacji"

#: gsr/params.py:160
msgid "Max lag (s)"
msgstr "Maks. opóźnienie (s)"

#: gsr/params.py:161
msgid "Signed mode (positive agreement only)"
msgstr "Tryb signed (tylko dodatnia zgodność)"

#: gsr/params.py:162
msgid "Compute DTW"
msgstr "Licz DTW"

#: gsr/params.py:163
msgid "Synchronization surrogate test"
msgstr "Test surogatowy synchronizacji"

#: gsr/params.py:164
msgid "Synchronization surrogate count"
msgstr "Liczba surogatów synchronizacji"

#: gsr/params.py:167
msgid "Surrogate method"
msgstr "Metoda surogatów"

#: gsr/params.py:169
msgid "circular shift"
msgstr "przesunięcie kołowe"

#: gsr/params.py:169
msgid "phase randomization"
msgstr "randomizacja fazy"

#: gsr/params.py:171 gsr/params.py:232
msgid "Surrogate seed"
msgstr "Seed surogatów"

#: gsr/params.py:172
msgid "Min. people per episode"
msgstr "Min. osób w epizodzie"

#: gsr/params.py:173
msgid "Min. episode duration (s)"
msgstr "Min. czas epizodu (s)"

#: gsr/params.py:174
msgid "Max gap (s)"
msgstr "Maks. przerwa (s)"

#: gsr/params.py:175
msgid "Clustering threshold"
msgstr "Próg klastrowania"

#: gsr/params.py:178
msgid "Downsampling interval (s)"
msgstr "Interwał downsamplingu (s)"

#: gsr/params.py:180
msgid ""
"The downsampling interval defines time sampling: 1 s = 1 Hz, 2 s = every 2 "
"seconds, etc. It reduces the number of analyzed points in whole seconds "
"while preserving the signal trend."
msgstr ""
"Interwał downsamplingu definiuje próbkowanie czasowe: 1 s = 1 Hz, 2 s = co 2 "
"sekundy itd. Pozwala redukować liczbę punktów do analizy przez "
"wielokrotności sekundy przy zachowaniu trendu sygnału."

#: gsr/params.py:191
msgid "High threshold (z)"
msgstr "Próg Wysoki (z)"

#: gsr/params.py:192
msgid ""
"z above this = High-arousal state (relative to the participant's own "
"baseline)."
msgstr ""
"z powyżej tej wartości = stan Wysokiego pobudzenia (względem własnej linii "
"bazowej uczestnika)."

#: gsr/params.py:194
msgid "Low threshold (z)"
msgstr "Próg Niski (z)"

#: gsr/params.py:194
msgid "z below this = Low-arousal state."
msgstr "z poniżej tej wartości = stan Niskiego pobudzenia."

#: gsr/params.py:197
msgid "Min. participants"
msgstr "Min. uczestników"

#: gsr/params.py:198
msgid ""
"Minimum number of participants in the same state for a second to count "
"toward an episode."
msgstr ""
"Minimalna liczba uczestników w tym samym stanie, aby sekunda liczyła się do "
"epizodu."

#: gsr/params.py:208
msgid ""
"Length of the sliding window for episode detection. Note: with the 0.05 Hz "
"filter the signal is very smooth, so pairwise correlation in a short window "
"can be inflated by a shared slow trend."
msgstr ""
"Długość okna przesuwnego do wykrywania epizodów. Uwaga: przy filtrze 0.05 Hz "
"sygnał jest bardzo gładki, więc korelacja parowa w krótkim oknie bywa "
"zawyżona przez wspólny wolny trend."

#: gsr/params.py:215
msgid "Agreement threshold"
msgstr "Próg zgodności"

#: gsr/params.py:216
msgid ""
"Fraction of the window where the condition (≥ min. participants in state) "
"must hold to form an episode."
msgstr ""
"Ułamek okna, w którym warunek (≥ min. uczestników w stanie) musi być "
"spełniony, aby powstał epizod."

#: gsr/params.py:220
msgid "Co-movement threshold (ρ)"
msgstr "Próg ko-ruchu (ρ)"

#: gsr/params.py:221
msgid ""
"Minimum mean pairwise Spearman correlation in a window to count it as co-"
"movement."
msgstr ""
"Minimalna średnia parowa korelacja Spearmana w oknie, aby uznać je za ko-"
"ruch."

#: gsr/params.py:225
msgid "Surrogate count"
msgstr "Liczba surogatów"

#: gsr/params.py:226
msgid ""
"Number of random circular shifts for the co-arousal index null distribution. "
"0 = skip the significance test."
msgstr ""
"Liczba losowych przesunięć kołowych do rozkładu zerowego indeksu ko-"
"pobudzenia. 0 = pomiń test istotności."

#: gsr/params.py:233
msgid "A fixed seed makes the co-arousal surrogate test reproducible."
msgstr "Stały seed zapewnia odtwarzalność testu surogatowego ko-pobudzenia."

#: gsr/params.py:306
msgid "defaults"
msgstr "domyślne"

#: gsr/params.py:307
#, python-format
msgid "%(count)d changed"
msgid_plural "%(count)d changed"
msgstr[0] "%(count)d zmieniony"
msgstr[1] "%(count)d zmienione"
msgstr[2] "%(count)d zmienionych"

#: gsr/params.py:314 gsr/templates/gsr/partials/param_field.html:12
msgid "full range"
msgstr "pełny zakres"

#: gsr/params.py:320
#, python-format
msgid "Signals: %(included)d/%(total)d"
msgstr "Sygnały: %(included)d/%(total)d"

#: gsr/params.py:321
#, python-format
msgid "Window: %(window)s"
msgstr "Okno: %(window)s"

#: gsr/params.py:322
#, python-format
msgid "Filters: %(enabled)d/%(total)d"
msgstr "Filtry: %(enabled)d/%(total)d"

#: gsr/params.py:323
#, python-format
msgid "Median: %(value)s"
msgstr "Mediana: %(value)s"

#: gsr/params.py:323
msgid "off"
msgstr "wył."

#: gsr/params.py:335
#, python-format
msgid "Threshold: %(value)s"
msgstr "Próg: %(value)s"

#: gsr/params.py:336
#, python-format
msgid "Window: %(value)s s"
msgstr "Okno: %(value)s s"

#: gsr/params.py:337
#, python-format
msgid "High/Low z: %(high)s/%(low)s"
msgstr "Próg wysoki/niski z: %(high)s/%(low)s"

#: gsr/params.py:338
#, python-format
msgid "Min. participants: %(value)s"
msgstr "Min. uczestników: %(value)s"

