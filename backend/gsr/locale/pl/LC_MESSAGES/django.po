msgstr ""
"Liczba momentów głównych musi być liczbą całkowitą od %(low)s do %(high)s."

#: gsr/services/interview.py:102
#, python-format
msgid ""
"The number of reserve moments must be a whole number from %(low)s to "
"%(high)s."
msgstr ""
"Liczba momentów rezerwowych musi być liczbą całkowitą od %(low)s do %(high)s."

#: gsr/services/interview.py:115
#, python-format
msgid "The asynchrony threshold must be a number from %(low)s to %(high)s."
msgstr "Próg asynchronii musi być liczbą od %(low)s do %(high)s."

#: gsr/services/results.py:251
