#: gsr/params.py:414 gsr/templates/gsr/partials/analysis_main.html:21
#: gsr/views.py:784 gsr/views.py:807
msgid "Synchronization"
msgstr "Synchronizacja"

#: gsr/params.py:415 gsr/templates/gsr/partials/analysis_main.html:22
#: gsr/views.py:789 gsr/views.py:809
msgid "Co-arousal"
msgstr "Ko-pobudzenie"

#: gsr/services/results.py:219
msgid "The file is missing. Upload it again."
msgstr "Brakuje pliku. Wgraj go ponownie."

#: gsr/templates/gsr/base.html:16
msgid "Skip to content"
msgstr "Przejdź do treści"

#: gsr/templates/gsr/base.html:18
msgid "Navigation"
msgstr "Nawigacja"

#: gsr/templates/gsr/base.html:21 gsr/templates/gsr/base.html:22
msgid "App"
msgstr "Aplikacja"

#: gsr/templates/gsr/base.html:24 gsr/templates/gsr/project_page.html:20
#: gsr/templates/gsr/projects.html:3 gsr/templates/gsr/projects.html:5
msgid "Projects"
msgstr "Projekty"

#: gsr/templates/gsr/base.html:24
msgid "all projects"
msgstr "wszystkie projekty"

#: gsr/templates/gsr/base.html:28
msgid "Language"
msgstr "Język"

#: gsr/templates/gsr/base.html:61
msgid "Computing…"
msgstr "Trwa obliczanie…"

#: gsr/templates/gsr/base.html:62
msgid "This can take up to a minute for long recordings."
msgstr "Przy długich nagraniach może to potrwać do minuty."

#: gsr/templates/gsr/partials/analysis_main.html:6
msgid "Select at least two signals to compute synchronization."
msgstr "Wybierz co najmniej dwa sygnały, aby policzyć synchronizację."

#: gsr/templates/gsr/partials/analysis_main.html:10
msgid "Analysis results"
msgstr "Wyniki analizy"

#: gsr/templates/gsr/partials/analysis_main.html:14
msgid "Pairs and subgroups whose signals move together"
msgstr "Pary i podgrupy, których sygnały zmieniają się razem"

#: gsr/templates/gsr/partials/analysis_main.html:18
msgid "Moments when participants share a High or Low arousal state"
msgstr "Momenty, w których uczestnicy są razem w stanie wysokiego lub niskiego pobudzenia"

#: gsr/templates/gsr/partials/analysis_main.html:24
msgid "No results for this step yet. Set the parameters and run the analysis."
msgstr "Brak wyników dla tego kroku. Ustaw parametry i uruchom analizę."

#: gsr/templates/gsr/partials/analysis_main.html:14
#: gsr/tests/test_views.py:1141
msgid "Run analysis"
msgstr "Uruchom analizę"

#: gsr/templates/gsr/partials/analysis_main.html:28
msgid "Settings or signals changed since this run. Run the analysis again."
msgstr ""
"Ustawienia lub sygnały zmieniły się od tego obliczenia. Uruchom analizę "
"ponownie."

#: gsr/templates/gsr/partials/analysis_main.html:33
msgid ""
"Mean of the pairs' maximum cross-correlation (the synchronization matrix "
"below)."
msgstr ""
"Średnia z maksymalnych korelacji wzajemnych par (macierz synchronizacji "
"poniżej)."

#: gsr/templates/gsr/partials/analysis_main.html:34
msgid ""
"Compares the mean synchrony with surrogate data in which the shared timing "
"is destroyed. Below 0.05 the group is synchronized above chance; a higher p-"
"value is not evidence of no synchrony."
msgstr ""
"Porównuje średnią synchronizację z danymi surogatowymi, w których wspólny "
"przebieg w czasie jest zniszczony. Poniżej 0,05 grupa jest zsynchronizowana "
"powyżej poziomu przypadku; wyższe p nie dowodzi braku synchronii."

#: gsr/templates/gsr/partials/analysis_main.html:37
#: gsr/templates/gsr/partials/analysis_main.html:139
msgid "Mean synchrony"
msgstr "Średnia synchronizacja"

#: gsr/templates/gsr/partials/analysis_main.html:39
msgid "mean of the pairs' maximum correlation"
msgstr "średnia maks. korelacji par"

