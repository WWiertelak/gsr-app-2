#: gsr/services/curation.py:246 gsr/services/curation.py:251
#: gsr/services/curation.py:253
msgid "Write the lesson time as m:ss, for example 12:30."
msgstr "Wpisz czas lekcji jako m:ss, na przykład 12:30."

#: gsr/services/curation.py:266
#, python-format
msgid "The reason may be at most %(count)s characters long."
msgstr "Powód może mieć najwyżej %(count)s znaków."

#: gsr/services/curation.py:270
#, python-format
msgid "The note may be at most %(count)s characters long."
msgstr "Notatka może mieć najwyżej %(count)s znaków."

#: gsr/services/curation.py:279
msgid "The moment must end after it starts."
msgstr "Moment musi kończyć się po swoim początku."

#: gsr/services/curation.py:283
msgid "The moment must lie within the analysed period of the lesson."
msgstr "Moment musi mieścić się w analizowanym okresie lekcji."

#: gsr/services/curation.py:291 gsr/services/curation.py:321
msgid ""
"The moment overlaps another moment of this interview; reject or move that one"
" first."
msgstr ""
"Moment nakłada się na inny moment tego wywiadu; najpierw odrzuć tamten albo "
"zmień jego czas."

#: gsr/services/curation.py:305
msgid "Remove a moment you added instead of rejecting it."
msgstr "Moment dodany ręcznie usuń zamiast go odrzucać."

#: gsr/services/curation.py:338
msgid "Restore a rejected moment before moving it."
msgstr "Przywróć odrzucony moment, zanim go przesuniesz."

#: gsr/services/curation.py:357
msgid "Give the reason for the change."
msgstr "Podaj powód zmiany."

#: gsr/services/curation.py:373 gsr/services/curation.py:414
msgid "Choose an interview of the current proposals."
msgstr "Wybierz wywiad z bieżących propozycji."

#: gsr/services/curation.py:376
msgid "Give the reason for adding the moment."
msgstr "Podaj powód dodania momentu."

#: gsr/services/curation.py:418
msgid ""
"This candidate is no longer in the moments chosen from the Analysis. Reload "
"the page."
msgstr ""
"Tego fragmentu nie ma już wśród fragmentów znalezionych w Analizie. Odśwież "
"stronę."

#: gsr/services/curation.py:423
msgid "This candidate is already on the interview's list."
msgstr "Ten fragment jest już na liście wywiadu."

#: gsr/services/curation.py:447
msgid "Reject a proposed moment instead of removing it."
msgstr "Proponowany moment odrzuć zamiast go usuwać."

#: gsr/services/display.py:32
msgid "Choose the z-score or the min-max (0–1) chart scale."
msgstr "Wybierz skalę wykresu z-score albo min-max (0–1)."

