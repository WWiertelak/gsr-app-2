msgstr "Pary i podgrupy, których sygnały zmieniają się razem"

#: gsr/templates/gsr/partials/analysis_main.html:18
msgid "Shared High or Low arousal states and co-movement episodes"
msgstr "Wspólne stany wysokiego lub niskiego pobudzenia i epizody ko-ruchu"

#: gsr/templates/gsr/partials/analysis_main.html:24
msgid "No results for this step yet. Set the parameters and run the analysis."
msgstr "Brak wyników dla tego kroku. Ustaw parametry i uruchom analizę."

