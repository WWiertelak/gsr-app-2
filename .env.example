# Copy to .env and adjust: cp .env.example .env
# Never commit .env.

# Required when DEBUG=0. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# 1 enables Django debug mode (dev only). Default in the container setup: 0.
DEBUG=0

# Comma-separated host names the app answers to. Keep localhost in the list:
# the container healthcheck requests http://localhost:8000.
ALLOWED_HOSTS=localhost,127.0.0.1

# Redirect HTTP to HTTPS when DEBUG=0. Keep 0 for plain http://localhost;
# set 1 behind a TLS-terminating proxy that sends X-Forwarded-Proto.
SECURE_SSL_REDIRECT=0
# Mark session and CSRF cookies Secure when DEBUG=0. Keep 0 for plain
# http://localhost (some browsers drop Secure cookies over HTTP); set 1 with TLS.
SECURE_COOKIES=0
# HSTS max-age in seconds when DEBUG=0 (0 disables HSTS; use 0 without TLS).
SECURE_HSTS_SECONDS=0

# Upload and analysis limits.
MAX_UPLOAD_MB=100
MAX_DATASETS=20

# Host port the app is published on (bound to 127.0.0.1).
APP_PORT=8000

# gunicorn tuning.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=300
